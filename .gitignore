# Python
.venv/
__pycache__/

# macOS
.DS_Store

# Hugging Face download cache
data/.cache/

# Data files larger than 50 MB (GitHub rejects files over 100 MB).
# Download these locally; see the Data section in README.md.
data/track1_tempo/bitcoin/documents.jsonl
data/track1_tempo/cardano/documents.jsonl
data/track1_tempo/economics/documents.jsonl
data/track1_tempo/genealogy/documents.jsonl
data/track1_tempo/history/documents.jsonl
data/track1_tempo/hsm/documents.jsonl
data/track1_tempo/law/documents.jsonl
data/track1_tempo/monero/documents.jsonl
data/track1_tempo/politics/documents.jsonl
data/track1_tempo/quant/documents.jsonl
data/track1_tempo/travel/documents.jsonl
data/track1_tempo/workplace/documents.jsonl
data/track2_recor/earth_science/documents.jsonl

# All remaining document corpora (smaller than 50 MB, but the dataset's
# .gitattributes routes every documents.jsonl through Git LFS).
data/**/documents.jsonl

# Local scratch file
a.py

# Official starter kit clone (cross-checks only)
external/

# Indexes, embeddings, LLM outputs
cache/

# Python tooling
*.egg-info/
.pytest_cache/

# Sparse variant runs: regenerate with python -m reteco.sparse.run --config configs/<name>.yaml
runs/*/sparse_*.trec
runs/*/sparse_*.meta.json
!runs/*/sparse_best.trec
!runs/*/sparse_best.meta.json

# Temporal reranker variants: keep only the selected system's runs
runs/*/bm25+temporal_*
!runs/*/bm25+temporal_fit_present.trec
!runs/*/bm25+temporal_fit_present.meta.json

# Dense/hybrid variant runs: keep only the selected systems' runs
runs/*/dense_*
runs/*/hybrid_*
!runs/*/dense_best.trec
!runs/*/dense_best.meta.json
!runs/*/hybrid_best.trec
!runs/*/hybrid_best.meta.json

# Second-stage variants and ablation runs: keep only the final system's runs
# (regenerate with python -m reteco.rerank.run / python -m reteco.pipeline)
runs/*/rerank_*
runs/*/final_*
runs/*/final+*
runs/*/*+rerank_temporal_*

# Python 3.13 environment for torch (see README)
.venv-dense/

# Playground runs (train split, scored on tune/holdout)
runs/*/pg_*
